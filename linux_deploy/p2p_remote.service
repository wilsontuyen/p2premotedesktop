[Unit]
Description=Easy Remote Desktop Service
After=network.target display-manager.service

[Service]
Type=simple
# Thay đổi đường dẫn này trỏ tới thư mục cài đặt thực tế của ứng dụng
WorkingDirectory=/opt/p2p_remote
ExecStart=/opt/p2p_remote/EasyRemoteDesktop --headless
Restart=always
RestartSec=3
TimeoutStopSec=10

# Các biến môi trường cần thiết để chạy trên Linux X11/Wayland (nếu có GUI ngầm)
Environment="DISPLAY=:0"
Environment="XAUTHORITY=/home/ubuntu/.Xauthority"
SupplementaryGroups=input

[Install]
WantedBy=multi-user.target
